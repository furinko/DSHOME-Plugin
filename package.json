{
  "name": "dshome-plugin",
  "version": "0.2.0-workbench.3",
  "description": "DSHOME Plugin — brand theme, conversation card layout, a VSCode-style turn minimap, and turn/member/approval reminders for DeepSeek Harness. Pure client plugin, no build step.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "minimap",
    "notifications"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./workbench-entry": "./lib/entry-workbench-f10a1138d50b.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node test/selftest.mjs && node test/domtest.mjs",
    "test:workbench": "node test/workbench.mjs",
    "test:workbench-browser": "node test/workbench-browser.mjs",
    "test:client-registry": "node test/client-registry.mjs",
    "test:workspace-model": "node --test test/workspace-model.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.5-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  }
}
